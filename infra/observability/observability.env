# Turns on OpenTelemetry in every service (ADR 0017):
#   docker compose --env-file .env --env-file infra/observability/observability.env --profile observability up -d
SPRING_PROFILES_ACTIVE=otlp
OTEL_TRACES_SAMPLE_RATIO=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
OTEL_METRIC_EXPORT_INTERVAL=15000
