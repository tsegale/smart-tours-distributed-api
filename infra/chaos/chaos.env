# Points tour-core's outbound providers at the provider-stubs WireMock container. Use as a second env file:
#   docker compose --profile chaos --env-file .env --env-file infra/chaos/chaos.env up -d --wait
# then switch faults with: python scripts/chaos.py <fx|weather|all> <healthy|slow|errors|dead>
FRANKFURTER_BASE_URL=http://provider-stubs:8080
OPEN_METEO_FORECAST_BASE_URL=http://provider-stubs:8080
OPEN_METEO_ARCHIVE_BASE_URL=http://provider-stubs:8080
