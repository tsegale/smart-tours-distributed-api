<?xml version="1.0" encoding="UTF-8"?>
<!-- Spring Boot's defaults (JSON on the console, from logging.structured.format.console), plus OTLP log export.
     The appender stays idle until TelemetryConfig installs the SDK, and the SDK exports nothing without an exporter. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureMdcAttributes>*</captureMdcAttributes>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
