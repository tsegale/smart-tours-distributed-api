# Copy to .env and change every secret before running anything outside your laptop.
#   cp .env.example .env
# docker compose reads .env automatically.

# --- Auth (shared HMAC secret until Keycloak lands in Phase 5) ---
# Base64-encoded, at least 32 bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# --- Databases: one per service (database-per-service pattern) ---
TOURS_DB_USER=tours
TOURS_DB_PASSWORD=change-me-tours
BOOKINGS_DB_USER=bookings
BOOKINGS_DB_PASSWORD=change-me-bookings
AI_DB_USER=ai
AI_DB_PASSWORD=change-me-ai

# --- Message broker ---
RABBITMQ_USER=smarttours
RABBITMQ_PASSWORD=change-me-rabbit

# --- Payments (booking-service). The defaults run with no Stripe account at all. ---
# fake: in-process provider, "pay" with scripts/fake_webhook.py.  stripe: Stripe test mode.
PAYMENT_PROVIDER=fake
# Stripe test-mode secret key (sk_test_...). Only needed with PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
# Webhook signing secret. Required for both providers. For Stripe, paste the whsec_... that
# `docker compose --profile payments logs stripe-cli` prints. For fake, any random string:
#   openssl rand -hex 32
STRIPE_WEBHOOK_SECRET=change-me-whsec
# Where Stripe Checkout sends the customer afterwards; {booking_id} is filled in.
CHECKOUT_SUCCESS_URL=http://localhost:3000/bookings/{booking_id}?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:3000/bookings/{booking_id}?checkout=cancelled

# --- Booking policy ---
# Seat hold while the customer pays. With Stripe it is raised to 32 minutes, because a
# Checkout Session must live at least 30 minutes and the hold must outlive it.
HOLD_MINUTES=30
# Cancelling a confirmed booking more than this many hours before departure refunds in full.
CANCELLATION_FULL_REFUND_HOURS=48
# pessimistic | optimistic | atomic. See docs/benchmarks/booking-locking.md.
RESERVATION_STRATEGY=pessimistic
