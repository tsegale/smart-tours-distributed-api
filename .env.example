# Copy to .env and change every secret before running anything outside your laptop.
#   cp .env.example .env
# docker compose reads .env automatically.

# --- Auth (ADR 0016) ---
# Local HS256 tokens from scripts/dev_token.py, so the default stack runs without Keycloak. Production: false.
DEV_TOKENS_ENABLED=true
# Base64-encoded, at least 32 bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# Keycloak (--profile auth). Its secrets are generated into secrets/ by scripts/keycloak_secrets.py, not kept here.
# Browser origins allowed to call the API, comma separated. Empty: none.
CORS_ALLOWED_ORIGINS=
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_WEB_ORIGIN=http://localhost:3000

# --- Databases: one per service (database-per-service pattern) ---
TOURS_DB_USER=tours
TOURS_DB_PASSWORD=change-me-tours
BOOKINGS_DB_USER=bookings
BOOKINGS_DB_PASSWORD=change-me-bookings
AI_DB_USER=ai
AI_DB_PASSWORD=change-me-ai

# --- AI itineraries (ADR 0021). Leave LLM_PROVIDER empty: the stack runs on the deterministic planner with no key. ---
# fake: canned plans, no network.  anthropic: ANTHROPIC_API_KEY.  openai: any compatible endpoint, Ollama included.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Message broker ---
RABBITMQ_USER=smarttours
RABBITMQ_PASSWORD=change-me-rabbit

# --- Payments (booking-service). The defaults run with no Stripe account at all. ---
# fake: in-process provider, "pay" with scripts/fake_webhook.py.  stripe: Stripe test mode.
PAYMENT_PROVIDER=fake
# Stripe test-mode secret key (sk_test_...). Only needed with PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
# Webhook signing secret. Required for both providers. For Stripe, paste the whsec_... that
# `docker compose --profile payments logs stripe-cli` prints. For fake, any random string:
#   openssl rand -hex 32
STRIPE_WEBHOOK_SECRET=change-me-whsec
# Where Stripe Checkout sends the customer afterwards; {booking_id} is filled in.
CHECKOUT_SUCCESS_URL=http://localhost:3000/bookings/{booking_id}?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:3000/bookings/{booking_id}?checkout=cancelled

# --- Booking policy ---
# Seat hold while the customer pays. With Stripe it is raised to 32 minutes, because a
# Checkout Session must live at least 30 minutes and the hold must outlive it.
HOLD_MINUTES=30
# Cancelling a confirmed booking more than this many hours before departure refunds in full.
CANCELLATION_FULL_REFUND_HOURS=48
# pessimistic | optimistic | atomic. See docs/benchmarks/booking-locking.md.
RESERVATION_STRATEGY=atomic

# --- Rate limiting at the gateway (ADR 0010): token bucket per caller, refill per second and burst ---
RATE_LIMIT_SEARCH_RPS=20
RATE_LIMIT_SEARCH_BURST=40
RATE_LIMIT_USER_RPS=10
RATE_LIMIT_USER_BURST=20
RATE_LIMIT_ANONYMOUS_RPS=5
RATE_LIMIT_ANONYMOUS_BURST=10
RATE_LIMIT_BOOKING_RPS=1
RATE_LIMIT_BOOKING_BURST=5
# CIDRs of load balancers in front of the gateway, comma separated. X-Forwarded-For is trusted only on
# connections from these. Empty: the TCP peer address is the client.
RATE_LIMIT_TRUSTED_PROXIES=

# --- Display currencies (tour-core, ADR 0011). Display only: bookings are always charged in NAD. ---
# Rates up to FX_FRESH_DAYS old are served as fresh, up to FX_MAX_AGE_DAYS as stale, older ones not at all.
FX_FRESH_DAYS=4
FX_MAX_AGE_DAYS=14
# A fetched rate that moved more than this against the one in use is rejected (keeps the old rates).
FX_MAX_MOVE_PERCENT=10
# NAD/ZAR must be within this of the 1:1 peg, or the whole fetch is rejected.
FX_PEG_TOLERANCE_PERCENT=0.5
# Daily refresh (Spring cron, Africa/Windhoek), on one instance at a time (ShedLock). "-" disables it.
FX_REFRESH_CRON="0 15 18 * * *"
# Refresh at start-up when no rates were fetched today.
FX_REFRESH_ON_STARTUP=true

# --- Departure weather (tour-core): how long a request waits for Open-Meteo (ADR 0012) ---
# Tour detail with include=weather never waits longer than this; GET /weather waits up to the second value.
WEATHER_INCLUDE_BUDGET=400ms
WEATHER_REQUEST_BUDGET=3s

# tour-core sends its own hot requests to itself before it reports ready (first request 10 s -> 1.3 s, measured).
# false starts it quicker, for local work that doesn't care about first-request latency.
WARM_UP_ENABLED=true

# --- Outbound providers. The defaults are the free public APIs; infra/chaos/chaos.env points them at the
# provider-stubs WireMock container instead. Open-Meteo's free API is for non-commercial use only (ADR 0012).
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com
# Commercial Open-Meteo plan: set the key and tour-core switches to the customer-* hosts. Empty: free API.
OPEN_METEO_API_KEY=

# --- Notifications (docker compose --profile notifications): emails, PDF tickets, check-in (ADRs 0014, 0015) ---
# Generate the secrets, e.g. openssl rand -base64 24. Also run once: python scripts/ticket_keys.py
NOTIFICATIONS_DB_USER=notifications
NOTIFICATIONS_DB_PASSWORD=change-me-notifications
MINIO_ROOT_USER=smarttours-admin
MINIO_ROOT_PASSWORD=change-me-minio-root
# The two least-privilege MinIO users: notification-service writes tickets, booking-service only reads them.
TICKETS_WRITER_SECRET_KEY=change-me-tickets-writer
TICKETS_READER_SECRET_KEY=change-me-tickets-reader
# Where the browser reaches MinIO: presigned ticket URLs are signed for this host.
TICKETS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Celery processes per container: notification-worker renders PDFs, notification-email-worker sends email. Then
# the per-worker send rate limit.
NOTIFICATION_WORKER_CONCURRENCY=2
NOTIFICATION_EMAIL_WORKER_CONCURRENCY=2
NOTIFICATIONS_SEND_RATE_LIMIT=10/s
# Flower (docker compose --profile notifications --profile flower): user:password for its basic auth.
FLOWER_BASIC_AUTH=admin:change-me-flower
